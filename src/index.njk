---
layout: layouts/base.njk
---
<section class="home-hero theme-night">
  <div class="glyphs" data-glyphs='{"form":"horizon","speed":0.65,"wobble":0.03,"grain":0,"flow":0.085,"breathe":0.05,"radius":0.8,"glyphScale":0.9375,"rim":1,"interior":0.6,"back":0.7,"brightness":0.8,"tilt":-0.06,"spray":0.5,"points":10000,"spin":0}' aria-hidden="true"></div>
  <div class="home-hero-content container">
    <h1 class="t-hero">{{ site.name }}</h1>
    <ul class="home-platforms" aria-label="Made for">
      {%- for mark in [["figma", "Figma"], ["adobe", "Adobe"], ["apple", "Mac"]] %}
      <li>{% include "icons/brand-" + mark[0] + ".svg" %}<span class="visually-hidden">{{ mark[1] }}</span></li>
      {%- endfor %}
    </ul>
    <p class="t-subhead home-hero-subhead">{{ site.tagline }}</p>
    <div class="cta-row">
      <a class="button button-primary" href="#lineup">Explore the lineup</a>
      <a class="button" href="/about/">About us</a>
    </div>
  </div>
</section>

<section class="promos" aria-label="Apps">
  {%- for app in catalog.apps %}
  <article class="promo {{ 'theme-dark' if loop.index in [1, 4] else 'theme-pool' }}">
    <p class="label promo-kind">{{ app.kind }}{% if not app.standalone %}s{% endif %}</p>
    <h2 class="promo-title">{{ app.name }}</h2>
    <p class="promo-subhead">{{ app.subhead }}</p>
    <div class="cta-row">
      <a class="button button-primary" href="{{ app.url }}">Learn more</a>
      {%- if not app.standalone %}
      <a class="button" href="{{ app.url }}#lineup">View plugins</a>
      {%- endif %}
    </div>
    <ul class="promo-visual{% if app.products.length == 1 %} promo-visual-single{% endif %}">
      {%- for p in app.products %}
      <li>
        <a href="{{ p.url }}" class="promo-product">
          <span class="promo-icon">{% include "icons/" + p.icon + ".svg" %}</span>
          <span class="promo-product-name">{{ p.name }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </article>
  {%- endfor %}
</section>

<section class="section theme-light" id="lineup">
  <div class="container container-wide">
    <div class="section-head reveal"><span class="section-index">01</span><span class="label">Lineup</span></div>
    <h2 class="t-l section-title reveal">Every tool, at a glance</h2>
    <ul class="lineup-row">
      {%- for p in catalog.lineup %}
      <li class="reveal">
        <a href="{{ p.url }}" class="lineup-item">
          <span class="lineup-icon">{% include "icons/" + p.icon + ".svg" %}</span>
          <span class="lineup-name">{{ p.name }}</span>
          <span class="lineup-app">{{ p.appNames | join(" · ") }}</span>
          <span class="lineup-text">{{ p.tagline }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section-statement theme-dark">
  <div class="container">
    <p class="t-xl statement reveal">{{ site.statement }}</p>
    <p class="statement-link reveal"><a class="link-chevron" href="/about/">About {{ site.name }}{% include "icons/chevron-right.svg" %}</a></p>
  </div>
</section>
