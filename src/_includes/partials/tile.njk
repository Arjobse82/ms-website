{#- Photo tile for one product. Expects `p` (a product) and optionally `tileSizes`. -#}
<a class="tile" href="{{ p.url }}" style="--focus: {{ p.focus }}; --zoom: {{ p.zoom }}">
  {% photo p.photo, { class: "tile-photo", sizes: tileSizes or "(max-width: 734px) 88vw, 600px" } %}
  <span class="tile-body">
    <span class="tile-icon">{% include "icons/" + p.icon + ".svg" %}</span>
    <span class="tile-name">{{ p.name }}</span>
    <span class="tile-app">{{ p.appName }}</span>
  </span>
</a>
