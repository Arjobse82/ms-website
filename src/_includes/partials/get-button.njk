{#- The Get button for product `p`; until it has a getUrl, its status instead: the house's grey pulsing dot and
    "Coming soon". Set `compact` for the local nav's size. -#}
{%- if p.getUrl -%}
<a class="button {{ 'button-small' if compact else 'button-primary' }}" href="{{ p.getUrl }}">Get{% if not compact %} {{ p.name }}{% endif %}</a>
{%- else -%}
<span class="status status-waiting{% if p.statusLed %} status-led{% endif %}{% if compact %} status-small{% endif %}"><span class="status-dot" aria-hidden="true"></span>Coming soon</span>
{%- endif -%}
