{#- Automated Assemblr as it looks in its dark theme (the owner's screenshot, 2026-11-07): Setup, its Pages tile open: the
    four tool tiles, the pages' strip, and Page 8's settings. A drawing, not the plugin. -#}
{%- macro step(value, wide = false) -%}<span class="pl-step{% if wide %} pl-step-wide{% endif %}"><i>−</i><b>{{ value }}</b><i>+</i></span>{%- endmacro %}
<div class="pl-left pl-left-tools">
  <div class="pl-tools pl-tools-2">
    <span class="pl-tool"><svg viewBox="7 7 34 34" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M9 14.5c0-1.4 1.1-2.5 2.5-2.5h8l3 3.5h14c1.4 0 2.5 1.1 2.5 2.5V35c0 1.4-1.1 2.5-2.5 2.5h-25C10.1 37.5 9 36.4 9 35z"/><circle cx="13" cy="16" r="2.4" fill="#4ade80" stroke="none"/></svg></span>
    <span class="pl-tool"><svg viewBox="7 7 34 34" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M15 9h13l7 7v21c0 1.1-.9 2-2 2H15c-1.1 0-2-.9-2-2V11c0-1.1.9-2 2-2z"/><path d="M28 9v7h7"/></svg></span>
    <span class="pl-tool"><svg viewBox="7 7 34 34" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 15h24M12 21h16"/><path d="M12 27h24M12 33h18" stroke-width="1.2" opacity=".6"/></svg></span>
    <span class="pl-tool"><svg viewBox="7 7 34 34" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="10" y="12" width="28" height="24" rx="2.5"/><path d="M10 19h28M10 25h28M10 31h28M20 19v17M29 19v17"/><path d="M10 14.5h28" stroke-width="3.2"/></svg></span>
  </div>
</div>
<div class="pl-right">
  <div class="pl-panel pl-panel-auto">
    <p class="pl-label">Pages</p>
    <div class="pl-chips"><span>All</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span class="is-on">8</span></div>
    <div class="pl-strip">
      <span class="pl-pg is-blank"></span>
      <span class="pl-pg"><b>1</b></span><span class="pl-pg is-grid"></span>
      <span class="pl-pg"><b>17</b></span><span class="pl-pg is-grid"></span>
      <span class="pl-pg pl-nums"><i>33</i><i>34</i><i>35</i><i>36</i><i>37</i><i>38</i></span>
      <span class="pl-pg pl-nums"><i>39</i><i>40</i><i>41</i><i>42</i><i>43</i><i>44</i></span>
    </div>
    <p class="pl-label pl-label-row">Page 8<span class="pl-up"></span></p>
    <div class="pl-fields">
      <span>Per page</span>{{ step(6) }}<span>Gap</span>{{ step("4.233 mm", true) }}
      <span>Copy height (%)</span>{{ step(25) }}<span>Inner gap</span>{{ step("2.117 mm", true) }}
      <span>Image floor (%)</span>{{ step(50) }}<span>Across</span><span class="pl-col">{{ step(3) }}<u>Document</u></span>
      <span>Down</span><span class="pl-col">{{ step(2) }}<u>Document</u></span>
    </div>
    <p class="pl-foot">50 products, 50 slots. Document has 8 page(s); 7 built.</p>
  </div>
</div>
