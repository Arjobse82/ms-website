{#- The Layout tile (the plugin's Product tile: catalague-producer src/photoshop/ui/main.ts productTile, src/assemblr/ui/sections.ts
    selectedUnitSection in its Photoshop flavour): the line-up drawing above the card; in the card Assemble (two more
    layers are selected), then the selected product in Line-up, and its layers. -#}
{%- from "panel/ui.njk" import hot, sel, btn %}
{%- set a = panel.art %}{% set r = a.row %}
{%- call hot(1) %}
<svg class="pt-drawing" viewBox="0 0 {{ r.view.w }} {{ r.view.h }}" aria-hidden="true">
  <line x1="{{ r.guide.x1 }}" y1="{{ r.guide.y }}" x2="{{ r.guide.x2 }}" y2="{{ r.guide.y }}" stroke="#fff" stroke-opacity=".35"/>
  <g fill="none" stroke="#111">
    {%- for it in r.items %}<rect x="{{ it.x }}" y="{{ it.y }}" width="{{ it.w }}" height="{{ it.h }}" rx="{{ it.rx }}" stroke-width="{{ it.stroke }}"/>{% endfor %}
  </g>
  <line x1="{{ r.axis.x1 }}" y1="{{ r.axis.y1 }}" x2="{{ r.axis.x2 }}" y2="{{ r.axis.y2 }}" stroke="#3372f6" stroke-width="5" stroke-linecap="round"/>
  <circle cx="{{ r.axis.x2 }}" cy="{{ r.axis.y2 }}" r="8" fill="#fff" stroke="#3372f6" stroke-width="3"/>
  <g fill="#fff">{% for p in r.anchors %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="7"/>{% endfor %}</g>
  <circle cx="{{ r.axis.mx }}" cy="{{ r.axis.my }}" r="7.5" fill="#3372f6" stroke="#fff" stroke-width="2"/>
</svg>
{%- endcall %}
<div class="pt-card ap">
  {%- call hot(2) %}
  <p class="pt-label">Assemble</p>
  <div class="pt-btns">{{ btn("Assemble", true) }}</div>
  <p class="pt-meta">{{ a.assemble }} layers can be assembled.</p>
  {%- endcall %}
  <hr class="pt-rule">
  {%- call hot(3) %}
  <div class="pt-modes"><span class="is-on">Line-up</span><span>Grid</span><span>Mosaic</span><span>Pins</span><span>Puzzle</span></div>
  {%- endcall %}
  {%- call hot(4) %}
  <p class="pt-label">Product</p>
  <span class="pt-input ap-name">{{ a.product.name }}</span>
  <p class="pt-meta">{{ a.product.board }} | {{ a.product.layers.length }} layers</p>
  {%- endcall %}
  {%- call hot(5) %}
  <div class="pt-field"><span class="pt-flabel pt-strong pt-dark">Align images</span><span class="pt-seg"><span>Top</span><span>Middle</span><span class="is-on">Bottom</span></span></div>
  <div class="pt-form"><span class="pt-flabel">Angle (°)</span>{{ sel("10") }}<span class="pt-flabel">Size (%)</span>{{ sel("63") }}<span class="pt-flabel">Scale (%)</span>{{ sel("100") }}<span class="pt-flabel">Bleed (%)</span>{{ sel("0") }}</div>
  <div class="pt-field"><span class="pt-flabel">Perspective (%)</span><span class="pt-input pt-narrow">10</span><span class="pt-slider" style="--at: 11%"></span></div>
  {%- endcall %}
  <div class="pt-btns ap-btns">{% call hot(6, true) %}{{ btn("Add selected") }}{% endcall %}{% call hot(7, true) %}{{ btn("Disconnect") }}{% endcall %}</div>
  {%- call hot(8) %}
  <div class="pt-btns">{{ btn("Swap order") }}</div>
  <p class="pt-info">The Layers panel puts {{ a.front.panel }} in front; the row's front is {{ a.front.row }}. Allow Assemblr to restack layers (settings) to make them agree.</p>
  {%- endcall %}
  <div class="pt-btns">{% call hot(9, true) %}{{ btn("Disassemble") }}{% endcall %}</div>
  <hr class="pt-rule">
  {%- call hot(10) %}
  <p class="pt-label">Layers</p>
  <div class="ap-strip">
    {%- for l in a.product.layers %}<span class="ap-thumb"><img src="{{ l.src }}" alt="{{ l.name }}" loading="lazy"></span>{% endfor %}
    <span class="ap-thumb ap-thumb-add" aria-hidden="true">+</span>
  </div>
  {%- endcall %}
</div>
