{%- from "panel/ui.njk" import hot, sel, box, btn, thumb %}
{%- call hot(1) %}
<svg class="pt-drawing" viewBox="0 0 400 220" aria-hidden="true">
  <line x1="24" y1="110" x2="376" y2="110" stroke="#fff" stroke-opacity=".35"/>
  <g fill="none" stroke="#111" stroke-width="3.5">
    <rect x="96" y="24" width="56" height="62" rx="9"/><rect x="138" y="52" width="62" height="66" rx="9"/><rect x="186" y="80" width="64" height="70" rx="9"/><rect x="236" y="112" width="66" height="70" rx="9"/><rect x="284" y="140" width="66" height="66" rx="9"/>
  </g>
  <line x1="140" y1="70" x2="298" y2="146" stroke="#3372f6" stroke-width="5" stroke-linecap="round"/>
  <circle cx="218" cy="108" r="8" fill="#fff" stroke="#3372f6" stroke-width="3"/>
  <circle cx="298" cy="146" r="8" fill="#3372f6" stroke="#fff" stroke-width="2.5"/>
  <g fill="#fff"><circle cx="24" cy="14" r="7"/><circle cx="200" cy="14" r="7"/><circle cx="376" cy="14" r="7"/><circle cx="24" cy="110" r="7"/><circle cx="376" cy="110" r="7"/><circle cx="24" cy="206" r="7"/><circle cx="376" cy="206" r="7"/></g>
  <circle cx="200" cy="206" r="7.5" fill="#3372f6"/>
</svg>
{%- endcall %}
<div class="pt-card">
  {%- call hot(2) %}
  <div class="pt-modes"><span class="is-on">Line-up</span><span>Grid</span><span>Mosaic</span><span>Pins</span><span>Puzzle</span></div>
  {%- endcall %}
  {%- call hot(3) %}
  <p class="pt-label">Product 328939 | Page 2</p>
  <p class="pt-title">Garden chair, teak</p>
  <p class="pt-meta">5 images placed</p>
  <div class="pt-line"><span class="pt-meta">The area, the copy and each image are separate frames.</span><span class="pt-link pt-right">Select them all</span></div>
  {%- endcall %}
  {%- call hot(4) %}
  <div class="pt-field"><span class="pt-flabel pt-strong">Align images</span><span class="pt-seg"><span>Top</span><span>Middle</span><span class="is-on">Bottom</span></span></div>
  <div class="pt-form"><span class="pt-flabel">Angle (°)</span>{{ sel("30") }}<span class="pt-flabel">Size (%)</span>{{ sel("47") }}<span class="pt-flabel">Scale (%)</span>{{ sel("90") }}<span class="pt-flabel">Bleed (%)</span>{{ sel("0") }}</div>
  <div class="pt-fieldhead">{{ box(false) }}<span>Add clipping path to alpha</span></div>
  <div class="pt-field"><span class="pt-flabel">Perspective (%)</span><span class="pt-input pt-narrow">10</span><span class="pt-slider" style="--at: 11%"></span></div>
  {%- endcall %}
  <div class="pt-btns">{% call hot(5, true) %}{{ btn("Apply to page") }}{{ btn("Apply to all") }}{% endcall %}{% call hot(6, true) %}{{ btn("Re-fit") }}{{ btn("Reset") }}{% endcall %}{{ btn("Swap order") }}</div>
  <div class="pt-line"><span class="pt-meta">Reset wider, each product keeping its mode:</span><span class="pt-right"><span class="pt-link">Reset page</span> <span class="pt-link">Reset all</span></span></div>
  <hr class="pt-rule">
  {%- call hot(7) %}
  <p class="pt-label">Images</p>
  <div class="pt-strip">{{ thumb("PSD", "#1") }}{{ thumb("PSD", "#2") }}{{ thumb("TIF", "#3") }}{{ thumb("PSD", "#4") }}<span class="pt-thumb pt-thumb-add"><span class="pt-thumb-img">+</span></span></div>
  <p class="pt-label pt-sub">˅ Unassigned files (2)</p>
  {%- endcall %}
</div>
