{#- How it works, a live grid: the page that starts at the Party pack on a 4 × 3 grid, cells joined, its products
    flowing on in the brief's order, and a label on how a cell's images are laid out again for its size; then the same
    page set to Free, its cells placed by hand. Each page's cells are drawn as blue boxes over it faded
    (src/_lib/catalogue-art.js `how.grid`). -#}
{%- from "panel/catalogue-producer/spread-ui.njk" import page, features %}
{%- set g = panels[panelId].art.how.grid %}
<div class="cw-pages">
  <div class="cw-side"><p class="hw-cap">{{ g.grid.label }}</p><div class="cs-frame cs-alone" style="--units: {{ g.grid.w }}">{{ page(g.grid) }}{{ features(g.grid.features, g.grid.w, g.grid.h, 11) }}</div></div>
  <div class="hw-go"><svg class="hw-go-arrow" viewBox="0 0 40 12"><path d="M0 6h37M32 1.5 36.5 6 32 10.5"/></svg></div>
  <div class="cw-side"><p class="hw-cap">{{ g.free.label }}</p><div class="cs-frame cs-alone" style="--units: {{ g.free.w }}">{{ page(g.free) }}</div></div>
</div>
