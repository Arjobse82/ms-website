{%- from "panel/ui.njk" import hot, sel, btn %}
<svg class="pt-drawing" viewBox="0 0 400 210" aria-hidden="true">
  <g fill="rgba(51,114,246,.28)" stroke="#3372f6" stroke-width="4"><rect x="196" y="20" width="58" height="58" rx="10"/><rect x="260" y="20" width="58" height="58" rx="10"/><rect x="324" y="20" width="58" height="58" rx="10"/></g>
  <circle cx="380" cy="20" r="10" fill="#fff" stroke="#3372f6" stroke-width="3"/>
  <rect x="20" y="132" width="58" height="58" rx="10" fill="none" stroke="#111" stroke-width="3.5"/>
  <circle cx="20" cy="190" r="10" fill="#111" stroke="#fff" stroke-width="3"/>
  <g><circle cx="20" cy="20" r="11" fill="#fff"/><path d="M20 14v12M14 20h12" stroke="#111" stroke-width="2.4"/></g>
  <g><circle cx="380" cy="190" r="11" fill="#fff"/><path d="M380 184v12M374 190h12" stroke="#111" stroke-width="2.4"/></g>
</svg>
<div class="pt-card">
  <p class="pt-label">Overlays</p>
  {%- call hot(1) %}
  <span class="pt-chip is-on">Product: 328939</span>
  <p class="pt-meta">Applies to 328939 wherever it goes.</p>
  {%- endcall %}
  {%- call hot(2) %}
  <div class="pt-line"><span class="pt-title">328939 | Top right</span><span class="pt-seg pt-right"><span class="is-on">Across</span><span>Down</span></span></div>
  <div class="pt-field"><span class="pt-flabel">Corner</span><span class="pt-seg pt-corners"><span class="c-tl"></span><span class="c-tr is-on"></span><span class="c-bl"></span><span class="c-br"></span></span></div>
  {%- endcall %}
  {%- call hot(3) %}<div class="pt-field"><span class="pt-flabel">Sources</span><span class="pt-chip">Badges ×</span>{{ sel("+ Column") }}</div>{% endcall %}
  {%- call hot(4) %}
  <div class="pt-form">
    <span class="pt-flabel">Resize scale</span><span class="pt-switch" aria-hidden="true"></span><span class="pt-flabel">Inset X</span>{{ sel("6 pt") }}
    <span class="pt-flabel">Gap</span>{{ sel("4 pt") }}<span class="pt-flabel">Inset Y</span>{{ sel("6 pt") }}
    <span class="pt-flabel">Max size</span><span class="pt-seg"><span class="is-on">pt</span><span>%</span></span><span class="pt-flabel">Max width</span>{{ sel("40 pt") }}
    <span></span><span></span><span class="pt-flabel">Max height</span>{{ sel("40 pt") }}
  </div>
  {%- endcall %}
  <div class="pt-btns">{{ btn("Apply this corner to document") }}</div>
  <hr class="pt-rule">
  {%- call hot(5) %}
  <p class="pt-label">Folders</p>
  <div class="pt-line"><span class="pt-title">Overlays</span><span class="pt-right">{{ btn("Choose folder…") }}</span></div>
  <p class="pt-meta">5 files: 3 badges, 2 devices<br>new.png, australian grown.png, 1 year warranty.psd<br>Price dollars.idml — $X.XX<br>Price cents.idml — XXc</p>
  {%- endcall %}
  {%- call hot(6) %}<div class="pt-line"><span class="pt-meta">No price sets: prices come from the overlays folder</span><span class="pt-right">{{ btn("Add price set…") }}</span></div>{% endcall %}
</div>
