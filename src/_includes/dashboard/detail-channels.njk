{#- Channels widget, opened: the status key and the channel's per-frame table, each frame's Baseplate and Logo checked against spec. Drawn from bloom reportsTable.js (_widgetFramesHtmlStd). Static sample data. -#}
{%- set lock = '<svg viewBox="0 0 16 16" width="14" height="14"><path d="M5.4 7.2V5.4a2.6 2.6 0 0 1 5.2 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><rect x="3.9" y="7.1" width="8.2" height="6" rx="1.3" fill="currentColor"/></svg>' -%}
{%- set known = '<svg viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.3"/><polyline points="5.4,8.2 7.2,10.4 10.8,5.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
{%- set unk = '<svg viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.3"/><text x="8" y="11" text-anchor="middle" font-size="8" font-family="ui-monospace,monospace" fill="currentColor">?</text></svg>' -%}
{%- set dia = '<svg width="8" height="8" viewBox="0 0 8 8" fill="none"><path d="M4 0.5L7.5 4L4 7.5L0.5 4Z" fill="currentColor"/></svg>' -%}
{%- set rows = [
  { st: 'official', size: '300×250', name: 'Zero Sugar', halo: 'pass', logo: 'pass' },
  { st: 'official', size: '728×90', name: 'Zero Sugar', halo: 'pass', logo: 'pass' },
  { st: 'official', size: '160×600', name: 'Zero Sugar', halo: 'fix', logo: 'pass', why: 'Baseplate floating 6px' },
  { st: 'official', size: '300×600', name: 'Cherry', halo: 'pass', logo: 'fix', why: 'logo 3.1% vs spec 4%' },
  { st: 'official', size: '970×250', name: 'Cherry', halo: 'pass', logo: 'pass' },
  { st: 'known', size: '320×50', name: 'Cherry', halo: 'pass', logo: 'pass' },
  { st: 'unknown', size: '600×314', name: 'Lime', halo: 'pass', logo: 'pass', why: 'non-standard size 600×314' }
] %}
<div class="sdu-channels">
  <div class="sdu-channels-legend">
    <span class="official">{{ lock | safe }}<span>5 official library sizes</span></span>
    <span class="known">{{ known | safe }}<span>1 known size</span></span>
    <span class="unknown">{{ unk | safe }}<span>1 new size</span></span>
  </div>
  <table class="sdu-channels-table">
    <thead><tr>
      <th></th><th>Frame</th>
      <th><span class="chip">{{ dia | safe }}<span>Baseplate</span></span></th>
      <th><span class="chip">{{ dia | safe }}<span>Logo</span></span></th>
    </tr></thead>
    <tbody>
    {%- for r in rows %}
      <tr class="{{ 'flag' if (r.halo == 'fix' or r.logo == 'fix') }}">
        <td class="st {{ r.st }}">{% if r.st == 'official' %}{{ lock | safe }}{% elif r.st == 'known' %}{{ known | safe }}{% else %}{{ unk | safe }}{% endif %}</td>
        <td class="nm"><b>{{ r.size }}</b> {{ r.name }}</td>
        <td class="c">{% if r.halo == 'fix' %}<span class="calc">calculate</span>{% else %}<span class="tk">✓</span> Pass{% endif %}</td>
        <td class="c">{% if r.logo == 'fix' %}<span class="calc">calculate</span>{% else %}<span class="tk">✓</span> Pass{% endif %}</td>
      </tr>
      {%- if r.why %}
      <tr class="why"><td></td><td colspan="3">{{ r.why }}</td></tr>
      {%- endif %}
    {%- endfor %}
    </tbody>
  </table>
</div>
