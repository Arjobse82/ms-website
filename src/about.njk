---
layout: layouts/base.njk
title: About
description: About Monochrome Systems, makers of plugins and agents for Figma, InDesign and Photoshop.
permalink: /about/
---
<section class="about-hero theme-light">
  <div class="container">
    <p class="label about-hero-kind">About</p>
    <h1 class="t-hero">{{ site.name }}</h1>
    <p class="t-subhead about-hero-subhead">{{ site.statement }}</p>
  </div>
  <div class="container container-wide">
    <div class="banner banner-vivid reveal" style="--focus: 50% 40%">
      {% photo "about", { class: "banner-photo", sizes: "(max-width: 734px) 88vw, 1260px", eager: true } %}
    </div>
  </div>
</section>

<section class="section theme-light">
  <div class="container">
    <div class="about-columns">
      <div class="reveal">
        <h2 class="t-s">{{ pages.about.makeTitle }}</h2>
        <p class="about-text">{{ pages.about.makeText }}</p>
      </div>
      <div class="reveal">
        <h2 class="t-s">{{ pages.about.workTitle }}</h2>
        <p class="about-text">{{ pages.about.workText }}</p>
      </div>
    </div>
  </div>
</section>

<section class="section theme-gray">
  <div class="container container-wide">
    <div class="section-head reveal"><span class="section-index">01</span><span class="label">Principles</span></div>
    <h2 class="t-l section-title reveal">{{ pages.about.principlesTitle }}</h2>
    <div class="principles">
      {%- for item in site.principles %}
      <div class="principle reveal">
        <p class="label principle-eyebrow">{{ item.eyebrow }}</p>
        <h3 class="principle-title">{{ item.title }}</h3>
        <p class="principle-text">{{ item.text }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section theme-light">
  <div class="container">
    <div class="section-head reveal"><span class="section-index">02</span><span class="label">Apps</span></div>
    <h2 class="t-l section-title reveal">{{ pages.about.appsTitle }}</h2>
    <ul class="app-rows">
      {%- for item in catalog.apps %}
      <li class="reveal">
        <a class="app-row" href="{{ item.url }}">
          <span class="app-row-name">{{ item.name }}</span>
          <span class="app-row-subhead">{{ item.subhead }}</span>
          {% include "icons/chevron-right.svg" %}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
