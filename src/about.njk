---
layout: layouts/base.njk
title: About
description: About Monochrome Systems, makers of plugins and agents for Figma, InDesign and Photoshop.
permalink: /about/
---
<section class="about-hero theme-light">
  <div class="container">
    <p class="t-eyebrow">About</p>
    <h1 class="t-hero">{{ site.name }}.</h1>
    <p class="t-subhead about-hero-subhead">{{ site.statement }}</p>
  </div>
  <div class="container container-wide">
    <div class="banner reveal" style="--focus: 50% 40%">
      {% photo "facade", { class: "banner-photo", sizes: "(max-width: 734px) 88vw, 1260px", eager: true } %}
    </div>
  </div>
</section>

<section class="section theme-light">
  <div class="container">
    <div class="about-columns">
      <div class="reveal">
        <h2 class="t-s">What we make.</h2>
        <p class="about-text">Plugins for Figma, InDesign and Photoshop, and an agent for advertising work. Each one is built to do a single job well inside the app you already use.</p>
      </div>
      <div class="reveal">
        <h2 class="t-s">How we work.</h2>
        <p class="about-text">A short paragraph about the team, how the tools get made and what matters to you. Replace this with your own words.</p>
      </div>
    </div>
  </div>
</section>

<section class="section theme-gray">
  <div class="container container-wide">
    <h2 class="t-l section-title reveal">What we believe.</h2>
    <div class="principles">
      {%- for item in site.principles %}
      <div class="principle reveal">
        <p class="principle-eyebrow">{{ item.eyebrow }}</p>
        <h3 class="principle-title">{{ item.title }}</h3>
        <p class="principle-text">{{ item.text }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section theme-light">
  <div class="container">
    <h2 class="t-l section-title reveal">The apps.</h2>
    <ul class="app-rows">
      {%- for item in catalog.apps %}
      <li class="reveal">
        <a class="app-row" href="{{ item.url }}">
          <span class="app-row-name">{{ item.name }}</span>
          <span class="app-row-subhead">{{ item.subhead }}</span>
          {% include "icons/chevron-right.svg" %}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
